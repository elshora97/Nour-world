# Netlify headers (copied into dist/ by the build, so they also apply to drag-and-drop deploys).

# The service worker and manifest must always be re-checked so updates reach installed apps.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# Hashed build files never change, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
